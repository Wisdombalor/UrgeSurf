# Copy to .env and fill in your Supabase project values.
# NEVER put the sb_secret_* key in this app — publishable key only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Admin allowlist (comma-separated login emails). Must match the address
# in supabase/schema.sql. Only these accounts see the Admin tab.
VITE_ADMIN_EMAILS=admin@example.com
